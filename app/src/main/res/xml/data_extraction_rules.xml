<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The OpenRouter key (AI edition) never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="videora_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="videora_ai.xml" />
    </device-transfer>
</data-extraction-rules>
