# R8 / ProGuard Keep Rules for Videora

# Keep all data models for Gson reflection
-keep class com.kevan.videorabykevan.model.** { *; }
-keepclassmembers class com.kevan.videorabykevan.model.** { *; }

# Keep Gson TypeToken and serialization attributes
-keepattributes Signature, *Annotation*, EnclosingMethod, InnerClasses
-keep class com.google.gson.** { *; }
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken

# Keep AndroidX Media3 ExoPlayer & Transformer
-keep class androidx.media3.** { *; }
-keepclassmembers class androidx.media3.** { *; }
-dontwarn androidx.media3.**

# Keep Coil
-keep class coil.** { *; }
-dontwarn coil.**
